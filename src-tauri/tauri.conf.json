{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "快看看图",
  "version": "1.0.0",
  "identifier": "com.imageviewer.quickview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "快看看图",
        "width": 1180,
        "height": 780,
        "minWidth": 420,
        "minHeight": 320,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 QuickView",
    "category": "Utility",
    "shortDescription": "轻量快速看图工具",
    "longDescription": "支持单张图片与文件夹浏览、键盘翻页、鼠标缩放的轻量看图工具",
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jpe", "jfif", "png", "gif", "bmp", "webp", "tif", "tiff", "ico", "avif", "svg"],
        "name": "Image",
        "description": "图片文件"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
